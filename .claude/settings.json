{
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "env": {
    "GIT_AUTHOR_NAME": "jjgroenendijk",
    "GIT_AUTHOR_EMAIL": "3110270+jjgroenendijk@users.noreply.github.com",
    "GIT_COMMITTER_NAME": "jjgroenendijk",
    "GIT_COMMITTER_EMAIL": "3110270+jjgroenendijk@users.noreply.github.com"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/session-start.sh",
            "timeout": 300,
            "statusMessage": "Checking node and dependencies"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/guard-bash.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/post-edit.sh",
            "timeout": 60,
            "statusMessage": "Typecheck + determinism lint"
          }
        ]
      }
    ]
  }
}
