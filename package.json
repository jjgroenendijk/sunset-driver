{
  "name": "sunset-driver",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Sunset Driver — a top-down open-world crime game for the browser. WebGPU + Rapier + Tone.js.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node scripts/lint-determinism.ts",
    "lint:size": "node scripts/check-size.ts",
    "test": "vitest run",
    "test:full": "SWEEP_SEEDS=500 vitest run",
    "test:render": "node scripts/render-check.ts",
    "test:world": "node scripts/world-check.ts",
    "verify": "npm run typecheck && npm run lint && npm run lint:size && npm run test",
    "verify:full": "npm run typecheck && npm run lint && npm run lint:size && npm run test:full"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/three": "^0.186.0",
    "@webgpu/types": "^0.1.72",
    "playwright-core": "^1.63.0",
    "tsapi": "npm:typescript@^5.9.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.134.0"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@trystero-p2p/mqtt": "^0.25.4",
    "@trystero-p2p/nostr": "^0.25.4",
    "three": "^0.186.0",
    "tone": "^15.1.22"
  }
}
