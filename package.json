{
  "name": "sunset-driver",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Sunset Driver — a top-down open-world crime game for the browser. WebGPU + Rapier + Tone.js.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint-determinism.ts",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "@webgpu/types": "^0.1.72",
    "tsapi": "npm:typescript@^5.9.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.130.0"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "three": "^0.186.0",
    "tone": "^15.1.22"
  }
}
